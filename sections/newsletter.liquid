<section class="section-space">
  <div class="container">
    <div class="newsletter-panel">
      <div class="newsletter-copy">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}<div class="rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>

      {% form 'customer', id: 'NewsletterForm', class: 'newsletter-form newsletter-form--large' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="NewsletterEmail-{{ section.id }}">Email address</label>
        <div class="newsletter-fields">
          <input id="NewsletterEmail-{{ section.id }}" class="input" type="email" name="contact[email]" value="{% if customer %}{{ customer.email }}{% endif %}" autocomplete="email" autocapitalize="off" placeholder="Email address" required>
          <button class="button button--primary" type="submit">{{ section.settings.button_label }}</button>
        </div>
        {%- if form.posted_successfully? -%}<p class="form-message" role="status">Thanks for subscribing.</p>{%- endif -%}
        {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in the loop" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Product news and store updates, sent to your inbox.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
