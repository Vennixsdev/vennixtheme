<div class="container section-space">
  {% render 'breadcrumbs' %}
  <div class="section-heading"><div><h1>{{ section.settings.heading }}</h1></div></div>
  <div class="collection-list collection-list--{{ section.settings.columns }}">
    {%- for collection_item in collections -%}
      {%- unless collection_item.handle == 'frontpage' -%}
        {%- assign collection_image = collection_item.image | default: collection_item.products.first.featured_image -%}
        <a class="collection-card" href="{{ collection_item.url }}">
          <div class="collection-card-media">{%- if collection_image != blank -%}{{ collection_image | image_url: width: 1000 | image_tag: widths: '320, 480, 640, 800, 1000', sizes: '(max-width: 749px) 82vw, 33vw', loading: 'lazy', alt: collection_item.title }}{%- else -%}<span class="media-placeholder" aria-hidden="true"></span>{%- endif -%}</div>
          <div class="collection-card-content"><h2>{{ collection_item.title }}</h2><p>{{ collection_item.products_count }} {{ collection_item.products_count | pluralize: 'product', 'products' }}</p></div>
        </a>
      {%- endunless -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list page",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Collections" },
    { "type": "select", "id": "columns", "label": "Desktop columns", "default": "3", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }] }
  ]
}
{% endschema %}
