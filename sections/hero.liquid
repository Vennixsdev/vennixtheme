<div class="container section--hero">
  <div class="shop-hero reveal">
    <div>
      <span class="eyebrow shop-hero-eyebrow">{{ section.settings.eyebrow | default: 'New drop · limited run' }}</span>
      <h1>{{ section.settings.heading | default: 'Engineered for <em>outliers</em>.' }}</h1>
      <p>{{ section.settings.subheading | default: 'Premium products designed with intention. Free shipping on orders over $75, 30-day returns, and real human support whenever you need it.' }}</p>
      <div style="display:flex;gap:.7rem;flex-wrap:wrap;">
        <a href="{{ section.settings.cta_url | default: collections.all.url }}" class="btn btn--primary btn--lg">{{ section.settings.cta_text | default: 'Shop the drop' }}</a>
        <a href="{{ section.settings.secondary_cta_url | default: routes.collections_url }}" class="btn btn--outline btn--lg">{{ section.settings.secondary_cta_text | default: 'Browse collections' }}</a>
      </div>
      <div style="display:flex;gap:1.2rem;margin-top:1.6rem;flex-wrap:wrap;">
        {%- for metric in section.blocks -%}
          {%- if metric.type == 'metric' -%}
            <div {{ metric.shopify_attributes }}>
              <strong style="display:block;font-size:1.4rem;background:linear-gradient(135deg,var(--color-accent),var(--color-accent-2));background-clip:text;color:transparent;-webkit-background-clip:text;">{{ metric.settings.value }}</strong>
              <small style="color:var(--color-muted);">{{ metric.settings.label }}</small>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
    <div class="shop-hero-media">
      {%- if section.settings.media != blank -%}
        <img src="{{ section.settings.media | image_url: width: 900 }}" alt="{{ section.settings.heading | escape }}">
      {%- else -%}
        <div style="width:100%;height:100%;display:grid;place-items:center;color:var(--color-muted);background:linear-gradient(135deg, var(--color-accent), var(--color-accent-2));">
          <svg viewBox="0 0 24 24" width="80" height="80" fill="none" stroke="rgba(255,255,255,0.6)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    { "type": "textarea", "id": "eyebrow", "label": "Eyebrow", "default": "New drop · limited run" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Engineered for outliers." },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Premium products designed with intention." },
    { "type": "image_picker", "id": "media", "label": "Hero image" },
    { "type": "text", "id": "cta_text", "label": "Primary CTA text", "default": "Shop the drop" },
    { "type": "url", "id": "cta_url", "label": "Primary CTA URL" },
    { "type": "text", "id": "secondary_cta_text", "label": "Secondary CTA text", "default": "Browse collections" },
    { "type": "url", "id": "secondary_cta_url", "label": "Secondary CTA URL" }
  ],
  "blocks": [
    {
      "type": "metric",
      "name": "Metric",
      "settings": [
        { "type": "text", "id": "value", "label": "Value", "default": "10k+" },
        { "type": "text", "id": "label", "label": "Label", "default": "Happy customers" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "metric", "settings": { "value": "12k+", "label": "Customers" } },
      { "type": "metric", "settings": { "value": "4.9★", "label": "Avg. rating" } },
      { "type": "metric", "settings": { "value": "24h", "label": "Avg. ship time" } }
    ]
  }
}
{% endschema %}
