{%- liquid
  assign primary_url = section.settings.primary_url
  if primary_url == blank
    assign primary_url = collections.all.url
  endif
-%}
<section class="hero-section{% if section.settings.full_width %} hero-section--full{% endif %}" style="--hero-min-height:{{ section.settings.height }}px;--hero-overlay:{{ section.settings.overlay_opacity | divided_by: 100.0 }};--hero-text:{{ section.settings.text_color }};">
  <div class="{% unless section.settings.full_width %}container{% endunless %}">
    <div class="hero hero--{{ section.settings.content_position }} hero--text-{{ section.settings.text_alignment }}{% if section.settings.desktop_image == blank %} hero--no-image{% endif %}">
      {%- if section.settings.desktop_image != blank -%}
        <picture class="hero-media">
          {%- if section.settings.mobile_image != blank -%}
            <source media="(max-width: 749px)" srcset="{{ section.settings.mobile_image | image_url: width: 480 }} 480w, {{ section.settings.mobile_image | image_url: width: 750 }} 750w, {{ section.settings.mobile_image | image_url: width: 1000 }} 1000w" sizes="100vw">
          {%- endif -%}
          {{ section.settings.desktop_image | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1800, 2200, 2400', sizes: '100vw', class: 'hero-image', alt: section.settings.image_alt, loading: 'eager', fetchpriority: 'high' }}
        </picture>
        <span class="hero-overlay" aria-hidden="true"></span>
      {%- else -%}
        <span class="hero-blank" aria-hidden="true"></span>
      {%- endif -%}

      <div class="hero-content">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h1>{{ section.settings.heading }}</h1>{%- endif -%}
        {%- if section.settings.text != blank -%}<div class="hero-text rte">{{ section.settings.text }}</div>{%- endif -%}
        {%- if section.settings.primary_label != blank or section.settings.secondary_label != blank -%}
          <div class="hero-actions">
            {%- if section.settings.primary_label != blank -%}<a class="button button--hero" href="{{ primary_url }}">{{ section.settings.primary_label }}</a>{%- endif -%}
            {%- if section.settings.secondary_label != blank and section.settings.secondary_url != blank -%}<a class="button button--hero-secondary" href="{{ section.settings.secondary_url }}">{{ section.settings.secondary_label }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Premium hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "desktop_image", "label": "Desktop image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "VennixStore" },
    { "type": "richtext", "id": "text", "label": "Supporting text" },
    { "type": "text", "id": "primary_label", "label": "Primary button label", "default": "Shop all" },
    { "type": "url", "id": "primary_url", "label": "Primary button link" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button label" },
    { "type": "url", "id": "secondary_url", "label": "Secondary button link" },
    { "type": "range", "id": "height", "min": 420, "max": 800, "step": 20, "unit": "px", "label": "Desktop height", "default": 620 },
    { "type": "range", "id": "overlay_opacity", "min": 0, "max": 80, "step": 5, "unit": "%", "label": "Image overlay", "default": 25 },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#ffffff" },
    { "type": "select", "id": "content_position", "label": "Content position", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
    { "type": "select", "id": "text_alignment", "label": "Text alignment", "default": "left", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }] },
    { "type": "checkbox", "id": "full_width", "label": "Full width", "default": false }
  ],
  "presets": [{ "name": "Premium hero" }]
}
{% endschema %}
