<div class="container section-space">
  <div class="empty-state">
    <p class="eyebrow">404</p>
    <h1>Page not found</h1>
    <p>The page you requested doesn’t exist or may have moved.</p>
    <div class="empty-state-links">
      <a class="button button--primary" href="{{ routes.root_url }}">Go to home page</a>
      <a class="button button--secondary" href="{{ routes.search_url }}">Search the store</a>
    </div>
  </div>
</div>

{% schema %}
{ "name": "404", "tag": "section" }
{% endschema %}
