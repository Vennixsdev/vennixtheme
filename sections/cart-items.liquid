<div class="container cart-page section-space">
  {% render 'breadcrumbs' %}
  <h1>{{ 'cart.general.title' | t }}</h1>

  {%- if cart.item_count == 0 -%}
    <div class="empty-state">
      <h2>{{ 'cart.general.empty' | t }}</h2>
      <a class="button button--primary" href="{{ collections.all.url }}">{{ 'cart.general.continue_shopping' | t }}</a>
    </div>
  {%- else -%}
    <form action="{{ routes.cart_url }}" method="post" id="CartPageForm">
      <div class="cart-page-layout">
        <div class="cart-page-lines" data-cart-lines>
          {%- for item in cart.items -%}
            <div class="cart-page-line" data-line-id="{{ item.key }}">
              <a class="cart-line-image" href="{{ item.url }}">{%- if item.image != blank -%}{{ item.image | image_url: width: 320 | image_tag: widths: '160, 240, 320', sizes: '(max-width: 600px) 96px, 140px', loading: 'lazy', alt: item.product.title }}{%- endif -%}</a>
              <div class="cart-line-details">
                <a class="cart-line-title" href="{{ item.url }}">{{ item.product.title }}</a>
                {%- unless item.product.has_only_default_variant -%}<p class="cart-line-variant">{{ item.variant.title }}</p>{%- endunless -%}
                {%- if item.selling_plan_allocation != blank -%}<p class="cart-line-variant">{{ item.selling_plan_allocation.selling_plan.name }}</p>{%- endif -%}
                {%- for property in item.properties -%}
                  {%- assign property_first = property.first | slice: 0 -%}
                  {%- if property.last != blank and property_first != '_' -%}
                    <p class="cart-line-property">{{ property.first }}: {{ property.last }}</p>
                  {%- endif -%}
                {%- endfor -%}
                <div class="cart-line-bottom">
                  <div class="quantity-picker" data-cart-line-id="{{ item.key }}">
                    <button type="button" data-cart-qty="-1" aria-label="Decrease {{ item.product.title | escape }} quantity">−</button>
                    <input type="number" name="updates[]" min="0" value="{{ item.quantity }}" data-cart-qty-input aria-label="Quantity for {{ item.product.title | escape }}">
                    <button type="button" data-cart-qty="1" aria-label="Increase {{ item.product.title | escape }} quantity">+</button>
                  </div>
                  <div class="cart-line-price">{%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}<strong>{{ item.final_line_price | money }}</strong></div>
                </div>
                <a class="cart-line-remove" href="{{ item.url_to_remove }}" data-cart-remove>{{ 'cart.general.remove' | t }}</a>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <aside class="cart-summary">
          {%- if settings.free_shipping_bar and settings.free_shipping_threshold != blank -%}
            {%- assign shipping_threshold = settings.free_shipping_threshold | times: 100 -%}
            {%- if shipping_threshold > 0 -%}
              {%- assign shipping_percent = cart.total_price | times: 100.0 | divided_by: shipping_threshold | at_most: 100 -%}
              <div class="shipping-progress-wrap" data-shipping-bar>
                <div class="shipping-progress" role="progressbar" aria-label="Free shipping progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ shipping_percent | round }}"><span class="shipping-progress-value" style="width:{{ shipping_percent }}%"></span></div>
                <p class="shipping-progress-text">{%- if cart.total_price >= shipping_threshold -%}{{ 'cart.free_shipping.progress_done' | t }}{%- else -%}{%- assign shipping_remaining = shipping_threshold | minus: cart.total_price -%}{%- assign shipping_remaining_formatted = shipping_remaining | money -%}{{ 'cart.free_shipping.progress_made' | t: remaining: shipping_remaining_formatted }}{%- endif -%}</p>
              </div>
            {%- endif -%}
          {%- endif -%}

          <label for="CartNote">{{ 'cart.general.note' | t }}</label>
          <textarea class="textarea" id="CartNote" name="note">{{ cart.note }}</textarea>
          <div class="cart-subtotal"><span>{{ 'cart.general.subtotal' | t }}</span><strong>{{ cart.items_subtotal_price | money }}</strong></div>
          <p class="cart-checkout-note">Shipping and taxes are calculated at checkout.</p>
          <button type="submit" name="update" class="button button--secondary button--full">{{ 'cart.general.update' | t }}</button>
          <button type="submit" name="checkout" class="button button--primary button--full">{{ 'cart.general.checkout' | t }}</button>
          {%- if settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}<div class="payment-icons" aria-label="Enabled payment methods">{%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag }}{%- endfor -%}</div>{%- endif -%}
        </aside>
      </div>
    </form>

    {%- if settings.show_cart_recommendations -%}
      <section class="cart-page-recommendations cart-recommendations" data-cart-recommendations data-product-id="{{ cart.items.first.product.id }}">
        <div class="section-heading"><div><h2>You may also like</h2></div></div>
        <div class="cart-recommendations-grid" data-cart-recommendations-grid></div>
      </section>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{ "name": "Cart", "tag": "section" }
{% endschema %}
