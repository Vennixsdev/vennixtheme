{%- liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
-%}
<div class="container product-section section-space" data-product-root data-section-id="{{ section.id }}" data-variants-id="VennixVariants-{{ section.id }}">
  {% render 'breadcrumbs' %}

  <div class="product-layout">
    <div class="product-gallery" data-product-gallery>
      <div class="product-media-stage" id="ProductMediaStage-{{ section.id }}" data-gallery-stage>
        {%- for media in product.media -%}
          <div class="product-media-item" data-media-item="{{ media.id }}" data-media-type="{{ media.media_type }}"{% unless forloop.first %} hidden{% endunless %}>
            {%- case media.media_type -%}
              {%- when 'image' -%}
                {%- if forloop.first -%}{%- assign media_loading = 'eager' -%}{%- assign media_priority = 'high' -%}{%- else -%}{%- assign media_loading = 'lazy' -%}{%- assign media_priority = 'auto' -%}{%- endif -%}
                <button type="button" class="product-image-zoom-button" data-zoom-open data-zoom-src="{{ media.preview_image | image_url: width: 2400 }}" data-zoom-alt="{{ media.alt | default: product.title | escape }}" aria-label="Zoom image {{ forloop.index }}">
                  {{ media.preview_image | image_url: width: 1800 | image_tag: widths: '480, 750, 1000, 1300, 1600, 1800', sizes: '(max-width: 989px) 100vw, 58vw', loading: media_loading, fetchpriority: media_priority, alt: media.alt | default: product.title }}
                </button>
              {%- when 'video' -%}
                <div class="product-video">{{ media | video_tag: controls: true, preload: 'metadata', image_size: '1200x' }}</div>
              {%- when 'external_video' -%}
                <div class="product-video">{{ media | external_video_tag }}</div>
              {%- when 'model' -%}
                <div class="product-model">{{ media | model_viewer_tag: image_size: '1200x', reveal: 'interaction', toggleable: true }}</div>
            {%- endcase -%}
          </div>
        {%- else -%}
          <span class="media-placeholder" aria-hidden="true"></span>
        {%- endfor -%}
      </div>

      {%- if product.media.size > 1 -%}
        <div class="product-thumbnails" aria-label="Product media">
          {%- for media in product.media -%}
            <button type="button" class="product-thumbnail" data-media-trigger="{{ media.id }}"{% if forloop.first %} aria-current="true"{% endif %} aria-label="Show {{ media.media_type }} {{ forloop.index }}">
              {{ media.preview_image | image_url: width: 180 | image_tag: widths: '90, 120, 180', sizes: '76px', loading: 'lazy', alt: '' }}
              {%- if media.media_type != 'image' -%}<span class="thumbnail-type">{{ media.media_type | replace: '_', ' ' }}</span>{%- endif -%}
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product-details" data-product-info data-product-id="{{ product.id }}" data-product-title="{{ product.title | escape }}" data-product-url="{{ product.url }}"{% if product.featured_image %} data-product-image="{{ product.featured_image | image_url: width: 800 }}"{% endif %}>
      {%- if settings.show_card_badges -%}{% render 'badge', product: product %}{%- endif -%}
      {%- if section.settings.show_vendor and product.vendor != blank -%}<a class="product-vendor" href="{{ product.vendor | url_for_vendor }}">{{ product.vendor }}</a>{%- endif -%}
      <h1>{{ product.title }}</h1>

      {%- if product.metafields.reviews.rating.value != blank -%}
        <p class="product-rating" aria-label="{{ product.metafields.reviews.rating.value }} out of {{ product.metafields.reviews.rating.value.scale_max }}">
          <span aria-hidden="true">★</span> {{ product.metafields.reviews.rating.value }}
          {%- if product.metafields.reviews.rating_count != blank -%}<span>({{ product.metafields.reviews.rating_count }})</span>{%- endif -%}
        </p>
      {%- endif -%}

      <div class="product-price" data-product-price aria-live="polite">{% render 'price', product: product, use_variant: true %}</div>
      <p class="product-availability{% unless selected_variant.available %} is-unavailable{% endunless %}" data-product-availability aria-live="polite">{% if selected_variant.available %}In stock{% else %}Sold out{% endif %}</p>

      {%- if cart.taxes_included or shop.shipping_policy != blank -%}
        <div class="product-tax-note">
          {%- if cart.taxes_included -%}{{ 'products.product.taxes_included' | t }}{%- endif -%}
          {%- if shop.shipping_policy != blank -%} {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}{%- endif -%}
        </div>
      {%- endif -%}

      {%- if product.description != blank -%}<div class="product-description rte">{{ product.description }}</div>{%- endif -%}

      {% form 'product', product, id: product_form_id, class: 'product-form', data-product-form: '' %}
        {% render 'product-info', product: product %}

        <div class="product-form-actions">
          <label class="quantity-label" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
          <div class="quantity-row">
            {% render 'quantity-selector', qty_mode: 'product', qty_section_id: section.id %}
            <button type="submit" class="button button--primary product-submit" data-add-to-cart{% unless selected_variant.available %} disabled{% endunless %}>
              {% if selected_variant.available %}{{ 'products.product.add_to_cart' | t }}{% else %}{{ 'products.product.sold_out' | t }}{% endif %}
            </button>
          </div>
          <div class="product-form-status" data-product-form-status role="status" aria-live="polite"></div>
        </div>

        {%- if section.settings.show_dynamic_checkout and selected_variant.available -%}<div class="dynamic-checkout">{{ form | payment_button }}</div>{%- endif -%}
        {{ form | payment_terms }}
      {% endform %}

      {%- if section.settings.show_sku -%}<p class="product-sku" data-product-sku{% if selected_variant.sku == blank %} hidden{% endif %}>SKU: <span>{{ selected_variant.sku }}</span></p>{%- endif -%}

      {%- assign trust_count = 0 -%}
      {%- for block in section.blocks -%}{%- if block.type == 'trust' and block.settings.text != blank -%}{%- assign trust_count = trust_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- if trust_count > 0 -%}
        <div class="product-trust" aria-label="Store information">
          {%- for block in section.blocks -%}
            {%- if block.type == 'trust' and block.settings.text != blank -%}
              <div class="product-trust-item" {{ block.shopify_attributes }}>
                <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12.5 10.5 15 16 9"/></svg>
                {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text }}</a>{%- else -%}<span>{{ block.settings.text }}</span>{%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="product-accordions">
        {%- if section.settings.show_shipping_policy and shop.shipping_policy != blank -%}
          <details><summary>Shipping information <span aria-hidden="true">+</span></summary><div class="accordion-content rte">{{ shop.shipping_policy.body }}</div></details>
        {%- endif -%}
        {%- if section.settings.show_refund_policy and shop.refund_policy != blank -%}
          <details><summary>Returns information <span aria-hidden="true">+</span></summary><div class="accordion-content rte">{{ shop.refund_policy.body }}</div></details>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'accordion' -%}
              {%- if block.settings.heading != blank and block.settings.body != blank -%}<details {{ block.shopify_attributes }}><summary>{{ block.settings.heading }} <span aria-hidden="true">+</span></summary><div class="accordion-content rte">{{ block.settings.body }}</div></details>{%- endif -%}
            {%- when 'page' -%}
              {%- if block.settings.page != blank -%}<details {{ block.shopify_attributes }}><summary>{{ block.settings.heading | default: block.settings.page.title }} <span aria-hidden="true">+</span></summary><div class="accordion-content rte">{{ block.settings.page.content }}</div></details>{%- endif -%}
          {%- endcase -%}
        {%- endfor -%}
      </div>

      <div class="product-meta-actions">
        {%- if settings.support_email != blank -%}<a href="mailto:{{ settings.support_email | escape }}?subject={{ product.title | url_encode }}">Questions? Email {{ settings.support_email }}</a>{%- endif -%}
        {%- if section.settings.show_share -%}<button type="button" data-share-trigger>Share</button>{%- endif -%}
      </div>
    </div>
  </div>
</div>

{%- if section.settings.show_sticky_add -%}
  <div class="sticky-add" data-sticky-atc aria-hidden="true">
    <div class="container sticky-add-inner">
      <div class="sticky-add-product">
        {%- if product.featured_image != blank -%}{{ product.featured_image | image_url: width: 120 | image_tag: width: 56, height: 56, loading: 'lazy', alt: '' }}{%- endif -%}
        <div><strong>{{ product.title }}</strong><span data-sticky-price>{{ selected_variant.price | money }}</span></div>
      </div>
      <button type="button" class="button button--primary" data-sticky-add{% unless selected_variant.available %} disabled{% endunless %}>{{ 'products.product.add_to_cart' | t }}</button>
    </div>
  </div>
{%- endif -%}

{%- if product.featured_image != blank -%}
  <dialog class="media-zoom" data-media-zoom aria-label="Product image zoom">
    <button type="button" class="icon-button media-zoom-close" data-zoom-close aria-label="{{ 'general.accessibility.close' | t }}">×</button>
    <img src="{{ product.featured_image | image_url: width: 2400 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}" data-zoom-image>
  </dialog>
{%- endif -%}

{% render 'product-variants', product: product %}
<script src="{{ 'product.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product information",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": false },
    { "type": "checkbox", "id": "show_sku", "label": "Show SKU", "default": false },
    { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show accelerated checkout", "default": true },
    { "type": "checkbox", "id": "show_shipping_policy", "label": "Show configured shipping policy", "default": true },
    { "type": "checkbox", "id": "show_refund_policy", "label": "Show configured refund policy", "default": true },
    { "type": "checkbox", "id": "show_sticky_add", "label": "Show sticky add-to-cart", "default": true },
    { "type": "checkbox", "id": "show_share", "label": "Show share button", "default": true }
  ],
  "blocks": [
    { "type": "trust", "name": "Information line", "settings": [{ "type": "text", "id": "text", "label": "Text", "default": "Customer support: support@vennixstore.com" }, { "type": "url", "id": "link", "label": "Link" }] },
    { "type": "accordion", "name": "Accordion", "settings": [{ "type": "text", "id": "heading", "label": "Heading" }, { "type": "richtext", "id": "body", "label": "Content" }] },
    { "type": "page", "name": "Page accordion", "settings": [{ "type": "text", "id": "heading", "label": "Custom heading" }, { "type": "page", "id": "page", "label": "Page" }] }
  ],
  "max_blocks": 12,
  "default": { "blocks": [{ "type": "trust" }] }
}
{% endschema %}
