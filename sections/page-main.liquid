<div class="container page-content section-space">
  {% render 'breadcrumbs' %}
  <h1>{{ page.title }}</h1>
  {%- if page.content != blank -%}<article class="prose" style="margin-top:28px">{{ page.content }}</article>{%- endif -%}

  {%- if page.handle == 'contact' -%}
    <section class="contact-panel" aria-labelledby="ContactHeading">
      <h2 id="ContactHeading">Contact us</h2>
      {% form 'contact', class: 'contact-form' %}
        {%- if form.posted_successfully? -%}<p class="form-message" role="status">Thanks for contacting us. We’ll be in touch.</p>{%- endif -%}
        {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        <div class="field"><label for="ContactName">Name</label><input class="input" id="ContactName" type="text" name="contact[name]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" autocomplete="name"></div>
        <div class="field"><label for="ContactEmail">Email</label><input class="input" id="ContactEmail" type="email" name="contact[email]" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" autocomplete="email" required></div>
        <div class="field"><label for="ContactPhone">Phone <span class="visually-hidden">(optional)</span></label><input class="input" id="ContactPhone" type="tel" name="contact[phone]" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}" autocomplete="tel"></div>
        <div class="field"><label for="ContactMessage">Message</label><textarea class="textarea" id="ContactMessage" name="contact[body]" required>{{ form.body }}</textarea></div>
        <button class="button button--primary" type="submit">Send message</button>
      {% endform %}
      {%- if settings.support_email != blank -%}<p style="margin-top:18px;font-size:.82rem">Or email <a href="mailto:{{ settings.support_email | escape }}" style="text-decoration:underline">{{ settings.support_email }}</a>.</p>{%- endif -%}
    </section>
  {%- endif -%}
</div>

{% schema %}
{ "name": "Page", "tag": "section" }
{% endschema %}
