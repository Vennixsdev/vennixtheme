<div class="container search-page section-space">
  {% render 'breadcrumbs' %}
  <header class="search-header">
    <p class="eyebrow">{{ 'general.search.title' | t }}</p>
    {%- if search.performed -%}
      <h1>{{ 'general.search.results' | t: terms: search.terms }}</h1>
      <p>{{ search.results_count }} {{ search.results_count | pluralize: 'result', 'results' }}</p>
    {%- else -%}
      <h1>{{ section.settings.heading }}</h1>
    {%- endif -%}
    {% render 'search-form' %}
  </header>

  {%- if search.performed -%}
    {%- paginate search.results by section.settings.results_per_page -%}
      {%- if search.results_count == 0 -%}
        <div class="empty-state">
          <h2>{{ 'general.search.no_results' | t }}</h2>
          <p>Try a different search term.</p>
          {%- assign suggestion_menu = settings.search_suggestions_menu -%}
          {%- if suggestion_menu != blank -%}
            <nav class="empty-state-links" aria-label="{{ 'general.search.browse' | t }}">
              {%- for link in suggestion_menu.links -%}<a class="button button--secondary" href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
            </nav>
          {%- else -%}
            <a class="button button--secondary" href="{{ routes.collections_url }}">{{ 'general.search.browse' | t }}</a>
          {%- endif -%}
        </div>
      {%- else -%}
        {%- assign product_result_count = 0 -%}
        {%- for item in search.results -%}{%- if item.object_type == 'product' -%}{%- assign product_result_count = product_result_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
        {%- if product_result_count > 0 -%}
          <section class="search-result-group" aria-labelledby="SearchProducts-{{ section.id }}">
            <h2 id="SearchProducts-{{ section.id }}">Products</h2>
            <div class="product-grid product-grid--{{ section.settings.columns_desktop }}" style="--mobile-columns:{{ section.settings.columns_mobile }}">
              {%- for item in search.results -%}{%- if item.object_type == 'product' -%}{% render 'product-card', product: item, loading: 'lazy' %}{%- endif -%}{%- endfor -%}
            </div>
          </section>
        {%- endif -%}

        {%- assign collection_result_count = 0 -%}
        {%- for item in search.results -%}{%- if item.object_type == 'collection' -%}{%- assign collection_result_count = collection_result_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
        {%- if collection_result_count > 0 -%}
          <section class="search-result-group" aria-labelledby="SearchCollections-{{ section.id }}">
            <h2 id="SearchCollections-{{ section.id }}">Collections</h2>
            <div class="search-collection-grid">
              {%- for item in search.results -%}
                {%- if item.object_type == 'collection' -%}
                  {%- assign result_image = item.image | default: item.products.first.featured_image -%}
                  <a class="search-collection-card" href="{{ item.url }}">
                    {%- if result_image != blank -%}{{ result_image | image_url: width: 600 | image_tag: widths: '240, 360, 480, 600', sizes: '(max-width: 749px) 50vw, 25vw', loading: 'lazy', alt: item.title }}{%- endif -%}
                    <strong>{{ item.title }}</strong>
                  </a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </section>
        {%- endif -%}

        {%- assign content_result_count = search.results_count | minus: product_result_count | minus: collection_result_count -%}
        {%- if content_result_count > 0 -%}
          <section class="search-result-group" aria-labelledby="SearchContent-{{ section.id }}">
            <h2 id="SearchContent-{{ section.id }}">Pages & articles</h2>
            <div class="search-content-list">
              {%- for item in search.results -%}
                {%- if item.object_type == 'page' or item.object_type == 'article' -%}
                  <a href="{{ item.url }}"><span>{{ item.object_type | capitalize }}</span><strong>{{ item.title }}</strong>{%- if item.content != blank -%}<p>{{ item.content | strip_html | truncatewords: 24 }}</p>{%- endif -%}</a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </section>
        {%- endif -%}

        {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Search pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  {%- else -%}
    {%- assign suggestion_menu = settings.search_suggestions_menu -%}
    {%- if suggestion_menu != blank -%}
      <nav class="search-browse" aria-label="{{ 'general.search.browse' | t }}">
        <h2>{{ 'general.search.browse' | t }}</h2>
        <div>{%- for link in suggestion_menu.links -%}<a class="button button--secondary" href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}</div>
      </nav>
    {%- endif -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search results",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What are you looking for?" },
    { "type": "checkbox", "id": "include_pages", "label": "Include pages", "default": true },
    { "type": "checkbox", "id": "include_articles", "label": "Include articles", "default": true },
    { "type": "range", "id": "results_per_page", "min": 12, "max": 48, "step": 4, "label": "Results per page", "default": 24 },
    { "type": "select", "id": "columns_desktop", "label": "Desktop product columns", "default": "4", "options": [{ "value": "3", "label": "3" }, { "value": "4", "label": "4" }, { "value": "5", "label": "5" }] },
    { "type": "select", "id": "columns_mobile", "label": "Mobile product columns", "default": "2", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }] }
  ]
}
{% endschema %}
