<div class="container section">
  {% render 'breadcrumbs' %}
  <small class="eyebrow">Editorial</small>
  <h1>{{ blog.title }}</h1>

  <div class="blog-grid" style="margin-top:1.4rem;display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:1rem;">
    {%- for article in blog.articles -%}
      <a href="{{ article.url }}" class="blog-card" style="border:1px solid var(--color-border);border-radius:var(--radius-lg);overflow:hidden;background:var(--color-surface);transition:transform .25s,border-color .25s;display:block;">
        {%- if article.image -%}
          <div style="aspect-ratio:3/2;overflow:hidden;">
            <img src="{{ article.image | image_url: width: 600 }}" alt="{{ article.title | escape }}" loading="lazy" style="width:100%;height:100%;object-fit:cover;">
          </div>
        {%- endif -%}
        <div style="padding:1rem;">
          <small style="color:var(--color-muted);">{{ article.published_at | date: '%b %d, %Y' }}</small>
          <h3 style="margin:.4rem 0;font-size:1.05rem;">{{ article.title }}</h3>
          <p style="color:color-mix(in oklab,var(--color-fg) 75%,transparent);font-size:.92rem;line-height:1.5;">{{ article.excerpt_or_content | strip_html | truncatewords: 32 }}</p>
        </div>
      </a>
    {%- else -%}
      <p style="color:var(--color-muted);">No articles yet — check back soon.</p>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Blog main",
  "tag": "section"
}
{% endschema %}
