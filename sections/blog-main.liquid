{%- paginate blog.articles by section.settings.articles_per_page -%}
  <div class="container section-space">
    {% render 'breadcrumbs' %}
    <header><h1>{{ blog.title }}</h1></header>
    {%- if blog.articles.size > 0 -%}
      <div class="blog-grid">
        {%- for article in blog.articles -%}
          <article class="blog-card">
            <a href="{{ article.url }}">
              {%- if article.image != blank -%}<div class="blog-card-media">{{ article.image | image_url: width: 1000 | image_tag: widths: '360, 540, 750, 1000', sizes: '(max-width: 749px) 100vw, 33vw', loading: 'lazy', alt: article.title }}</div>{%- endif -%}
              <div class="blog-card-content">
                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>
                <h2>{{ article.title }}</h2>
                {%- if article.excerpt_or_content != blank -%}<p>{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>{%- endif -%}
              </div>
            </a>
          </article>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Blog pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
    {%- else -%}
      <div class="empty-state" style="margin-top:32px"><h2>No articles yet</h2></div>
    {%- endif -%}
  </div>
{%- endpaginate -%}

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "settings": [{ "type": "range", "id": "articles_per_page", "min": 6, "max": 24, "step": 3, "label": "Articles per page", "default": 12 }]
}
{% endschema %}
