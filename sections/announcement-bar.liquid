{%- liquid
  assign enabled = section.settings.enabled
  if enabled and section.settings.message != blank
-%}
<div class="vannouncement" data-section-id="{{ section.id }}">
  <div class="container vannouncement-bar">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}" class="vannouncement-link">
        <strong>{{ section.settings.message }}</strong>
        {%- if section.settings.cta_label != blank -%}
          <span class="vannouncement-cta">{{ section.settings.cta_label }} →</span>
        {%- endif -%}
      </a>
    {%- else -%}
      <strong>{{ section.settings.message }}</strong>
    {%- endif -%}
    {%- if section.settings.dismissable -%}
      <button type="button" class="vannouncement-close" data-vannouncement-close aria-label="Close announcement">×</button>
    {%- endif -%}
  </div>
</div>
<style>
.vannouncement{position:sticky;top:0;z-index:60;background:linear-gradient(90deg,var(--color-accent),var(--color-accent-2));color:#fff;font-size:.85rem}
.vannouncement-bar{display:flex;align-items:center;gap:1rem;justify-content:center;padding:.5rem 1rem;position:relative}
.vannouncement-link{display:flex;gap:.7rem;align-items:center;font-weight:500;flex-wrap:wrap;justify-content:center;text-align:center}
.vannouncement-cta{background:rgba(0,0,0,.18);padding:2px 9px;border-radius:999px;font-size:.78rem;font-weight:600}
.vannouncement-close{position:absolute;right:1rem;top:50%;transform:translateY(-50%);width:24px;height:24px;border-radius:50%;display:grid;place-items:center;color:#fff;background:rgba(0,0,0,.18)}
.vannouncement-close:hover{background:rgba(0,0,0,.32)}
</style>
<script>
document.addEventListener('click', (e) => {
  if (e.target.matches('[data-vannouncement-close]')) {
    const node = e.target.closest('.vannouncement');
    if (node) {
      node.style.display = 'none';
      try { localStorage.setItem('vxn_vannounce__{{ section.id }}', '1'); } catch {}
    }
  }
});
document.addEventListener('DOMContentLoaded', () => {
  try {
    if (localStorage.getItem('vxn_vannounce__{{ section.id }}') === '1') {
      const node = document.querySelector('.vannouncement');
      if (node) node.style.display = 'none';
    }
  } catch {}
});
</script>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show", "default": true },
    { "type": "text", "id": "message", "default": "Free shipping on orders $75+ · 30-day returns" },
    { "type": "text", "id": "cta_label", "default": "Shop now" },
    { "type": "url", "id": "link", "label": "Link to" },
    { "type": "checkbox", "id": "dismissable", "label": "Dismissable", "default": false }
  ]
}
{% endschema %}
