{%- if section.settings.enabled and section.settings.message != blank -%}
  <aside class="announcement" data-announcement data-announcement-id="{{ section.id }}" aria-label="Announcement">
    <div class="container announcement-inner">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">
          <span>{{ section.settings.message }}</span>
          {%- if section.settings.link_label != blank -%}<strong>{{ section.settings.link_label }}</strong>{%- endif -%}
        </a>
      {%- else -%}
        <p>{{ section.settings.message }}</p>
      {%- endif -%}
      {%- if section.settings.dismissible -%}
        <button type="button" data-announcement-close aria-label="{{ 'general.accessibility.close' | t }}">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19"/></svg>
        </button>
      {%- endif -%}
    </div>
  </aside>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "announcement-section",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show announcement", "default": false },
    { "type": "text", "id": "message", "label": "Message" },
    { "type": "text", "id": "link_label", "label": "Link label" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "checkbox", "id": "dismissible", "label": "Allow dismissal", "default": false }
  ]
}
{% endschema %}
