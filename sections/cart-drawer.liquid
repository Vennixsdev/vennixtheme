<div class="cart-drawer" data-cart-drawer role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" tabindex="-1">
  <div class="cart-drawer-header">
    <div>
      <h2 id="CartDrawerTitle">{{ 'cart.general.title' | t }}</h2>
      <p data-cart-count-inline>{{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}</p>
    </div>
    <button type="button" class="icon-button" data-cart-close aria-label="{{ 'general.accessibility.close' | t }}">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19"/></svg>
    </button>
  </div>

  <div class="cart-drawer-scroll">
    <div class="cart-drawer-body" data-cart-body>
      {%- if cart.item_count == 0 -%}
        <div class="cart-empty">
          <h3>{{ 'cart.general.empty' | t }}</h3>
          <a class="button button--secondary" href="{{ collections.all.url }}" data-cart-close>{{ 'cart.general.continue_shopping' | t }}</a>
        </div>
      {%- else -%}
        {% render 'cart-line-list', cart: cart %}
      {%- endif -%}
    </div>

    {%- if settings.show_cart_recommendations -%}
      <section class="cart-recommendations" data-cart-recommendations data-product-id="{{ cart.items.first.product.id }}"{% if cart.item_count == 0 %} hidden{% endif %}>
        <h3>You may also like</h3>
        <div class="cart-recommendations-grid" data-cart-recommendations-grid></div>
      </section>
    {%- endif -%}
  </div>

  <div class="cart-drawer-footer" data-cart-footer{% if cart.item_count == 0 %} hidden{% endif %}>
    {%- if settings.free_shipping_bar and settings.free_shipping_threshold != blank -%}
      {%- assign shipping_threshold = settings.free_shipping_threshold | times: 100 -%}
      {%- if shipping_threshold > 0 -%}
        {%- assign shipping_percent = cart.total_price | times: 100.0 | divided_by: shipping_threshold | at_most: 100 -%}
        <div class="shipping-progress-wrap" data-shipping-bar>
          <div class="shipping-progress" role="progressbar" aria-label="Free shipping progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ shipping_percent | round }}"><span class="shipping-progress-value" style="width:{{ shipping_percent }}%"></span></div>
          <p class="shipping-progress-text">{%- if cart.total_price >= shipping_threshold -%}{{ 'cart.free_shipping.progress_done' | t }}{%- else -%}{%- assign shipping_remaining = shipping_threshold | minus: cart.total_price -%}{%- assign shipping_remaining_formatted = shipping_remaining | money -%}{{ 'cart.free_shipping.progress_made' | t: remaining: shipping_remaining_formatted }}{%- endif -%}</p>
        </div>
      {%- endif -%}
    {%- endif -%}

    <div class="cart-subtotal"><span>{{ 'cart.general.subtotal' | t }}</span><strong data-cart-subtotal>{{ cart.items_subtotal_price | money }}</strong></div>
    <p class="cart-checkout-note">Shipping and taxes are calculated at checkout.</p>
    <form action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="button button--primary button--full">{{ 'cart.general.checkout' | t }}</button>
    </form>
    <div class="cart-footer-links"><button type="button" data-cart-close>{{ 'cart.general.continue_shopping' | t }}</button><a href="{{ routes.cart_url }}">View cart</a></div>
  </div>

  <div class="cart-error" data-cart-error role="alert" hidden></div>
</div>

{% schema %}
{
  "name": "Cart drawer",
  "settings": []
}
{% endschema %}
