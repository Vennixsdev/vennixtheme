<div class="cart-drawer" data-cart-drawer>
  <div class="cart-drawer-head">
    <h2>Your cart <small style="color:var(--color-muted);font-weight:500;" data-cart-count-inline>· {{ cart.item_count }} {{ cart.item_count | pluralize: 'item', 'items' }}</small></h2>
    <button type="button" class="overlay-close" data-cart-close aria-label="Close cart">×</button>
  </div>

  <div class="cart-drawer-body" data-cart-body>
    {%- if cart.empty? -%}
      <div class="cart-drawer-empty">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <strong style="display:block;margin-bottom:.4rem;color:var(--color-fg);">Your cart is empty</strong>
        <p style="font-size:.9rem;max-width:24ch;margin:0 auto;">Browse our products — your finds await here.</p>
        <a href="{{ collections.all.url }}" class="btn btn--ghost" style="margin-top:1rem;" data-cart-close>Continue shopping</a>
      </div>
    {%- else -%}
      {%- assign lines_rendered = true -%}
      {%- include 'cart-line-list' -%}
    {%- endif -%}
  </div>

  {%- unless cart.empty? -%}
    <div class="cart-upsell" data-cart-upsell>
      <h3>You may also like</h3>
      <div class="cart-upsell-grid">
        {%- assign products_to_show = '',' ','' -%}
        {%- for i in (1..4) -%}
          {%- assign idx = i | plus: 0 -%}
          {%- if collections['recommended'] != blank and collections['recommended'].products.size > 0 -%}
            {%- assign p = collections['recommended'].products[i | minus: 1] -%}
            {%- if p != blank -%}
              <div class="cart-upsell-card" data-upsell-card data-product-id="{{ p.id }}" data-variant-id="{{ p.variants.first.id }}">
                <div style="aspect-ratio:1/1;border-radius:var(--radius-md);overflow:hidden;background:var(--color-surface-2);">
                  {%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 200 }}" alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;">{%- endif -%}
                </div>
                <div style="padding-top:.5rem;font-size:.85rem;font-weight:600;line-height:1.3;">{{ p.title | truncatewords: 6 }}</div>
                <div style="display:flex;justify-content:space-between;align-items:center;margin-top:.3rem;">
                  <span>{{ p.price | money }}</span>
                  <button type="button" class="btn btn--text" style="padding:.3rem .5rem;font-size:.78rem;" data-upsell-add>+ Add</button>
                </div>
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>

    <div class="cart-drawer-foot" data-cart-foot>
      {%- if settings.free_shipping_bar -%}
        <div data-shipping-bar data-shipping-bar-drawer>
          {%- assign threshold = settings.free_shipping_threshold | times: 100 -%}
          {%- assign pct = cart.total_price | times: 100 | divided_by: threshold | at_most: 100 -%}
          <div class="shipping-progress"><div class="shipping-progress-bar" style="width: {{ pct }}%;"></div></div>
          {%- if cart.total_price >= threshold -%}
            <p class="shipping-progress-text">🎉 You get <strong>FREE shipping</strong>!</p>
          {%- else -%}
            {%- assign remaining = threshold | minus: cart.total_price -%}
            <p class="shipping-progress-text">Add <strong>{{ remaining | money }}</strong> more for free shipping</p>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="cart-drawer-subtotal">
        <span>Subtotal</span>
        <strong data-cart-subtotal>{{ cart.items_subtotal_price | money }}</strong>
      </div>
      <small style="color:var(--color-muted);text-align:center;">Shipping &amp; taxes calculated at checkout</small>
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <button type="submit" name="checkout" class="btn btn--primary btn--block btn--lg">Checkout</button>
      </form>
      <a href="{{ routes.cart_url }}" class="cart-full-page">View full cart →</a>
    </div>
  {%- endunless -%}
</div>
