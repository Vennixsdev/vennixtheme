<link rel="stylesheet" href="{{ 'product-recommendations.css' | asset_url }}" media="none">
{%- liquid
  assign limit = section.settings.products_to_show | default: 4 | plus: 0
-%}
<div class="container section" data-product-recommendations
  data-product-id="{{ product.id }}"
  data-limit="{{ limit }}"
  data-section-id="{{ section.id }}">
  <div class="heading-row">
    <div>
      <small class="eyebrow">{{ section.settings.eyebrow | default: 'You may also like' }}</small>
      <h2>{{ section.settings.title | default: 'Complete the look' }}</h2>
    </div>
    <div style="display:flex;gap:.4rem;">
      <button type="button" class="icon-btn" data-rec-scroll="prev" aria-label="Previous">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <button type="button" class="icon-btn" data-rec-scroll="next" aria-label="Next">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </button>
    </div>
  </div>

  <div class="product-recommendations-grid" data-rec-grid>
    {%- for i in (1..limit) -%}
      <div class="recommendations-skeleton" aria-hidden="true"></div>
    {%- endfor -%}
  </div>
</div>

<script type="application/json" id="VennixRecommendationConfig">
  {
    "baseUrl": "{{ routes.product_recommendations_url }}",
    "productId": {{ product.id }},
    "limit": {{ limit }}
  }
</script>
{{ 'recommendations.js' | asset_url | script_tag: defer: true }}

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "default": "You may also like" },
    { "type": "text", "id": "title", "default": "Complete the look" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 10, "step": 1, "default": 4 }
  ]
}
{% endschema %}
