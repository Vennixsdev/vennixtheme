<div
  class="product-recommendations-section"
  data-product-recommendations
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent={{ section.settings.intent }}"
  {% unless recommendations.performed and recommendations.products_count > 0 %}hidden{% endunless %}
>
  {%- if recommendations.performed and recommendations.products_count > 0 -%}
    <section class="section-space" aria-labelledby="RecommendationsHeading-{{ section.id }}">
      <div class="container">
        <div class="section-heading"><div><h2 id="RecommendationsHeading-{{ section.id }}">{{ section.settings.heading }}</h2></div></div>
        <div class="product-grid product-grid--4" style="--mobile-columns:2">
          {%- for item in recommendations.products -%}{% render 'product-card', product: item, loading: 'lazy' %}{%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}
</div>
<script src="{{ 'recommendations.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product recommendations",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "select", "id": "intent", "label": "Recommendation type", "default": "related", "options": [{ "value": "related", "label": "Related" }, { "value": "complementary", "label": "Complementary" }] },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "Products to show", "default": 4 }
  ]
}
{% endschema %}
