{%- assign primary_menu = section.settings.menu -%}
<header class="site-header" data-header data-sticky="{{ settings.sticky_header }}">
  <div class="container header-bar">
    <button
      type="button"
      class="icon-button menu-toggle"
      data-mobile-trigger
      aria-expanded="false"
      aria-controls="MobileMenu-{{ section.id }}"
      aria-label="{{ 'general.accessibility.menu' | t }}"
    >
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
    </button>
    <noscript>
      <a class="icon-button" href="{{ routes.collections_url }}" aria-label="{{ 'general.search.browse' | t }}">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </a>
    </noscript>

    <a class="header-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} — Home">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 480 | image_tag: widths: '144, 208, 256, 384, 480', sizes: '(max-width: 989px) var(--mobile-logo-width), var(--logo-width)', class: 'header-logo-image', alt: shop.name, loading: 'eager' }}
      {%- else -%}
        <span class="wordmark">{{ shop.name }}</span>
      {%- endif -%}
    </a>

    {%- if primary_menu != blank -%}
      <nav class="header-nav" aria-label="Primary navigation">
        <ul class="header-nav-list" role="list">
          {%- for link in primary_menu.links -%}
            <li class="header-nav-item{% if link.links.size > 0 %} has-mega{% endif %}"{% if link.links.size > 0 %} data-mega{% endif %}>
              <div class="header-nav-link-wrap">
                <a class="header-nav-link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title }}</a>
                {%- if link.links.size > 0 -%}
                  <button
                    type="button"
                    class="mega-toggle"
                    aria-expanded="false"
                    aria-controls="MegaMenu-{{ section.id }}-{{ link.handle }}"
                    aria-label="Open {{ link.title | escape }} menu"
                    data-mega-toggle
                  >
                    <svg viewBox="0 0 12 8" width="12" height="8" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m1 1 5 5 5-5"/></svg>
                  </button>
                  {% render 'mega-menu', link: link, menu_id: section.id, featured_collection: section.settings.mega_feature_collection, featured_product: section.settings.mega_feature_product, promo_image: section.settings.mega_promo_image, promo_heading: section.settings.mega_promo_heading, promo_link: section.settings.mega_promo_link %}
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    <div class="header-actions">
      {%- if section.settings.show_search -%}
        {%- if settings.enable_predictive -%}
          <button type="button" class="icon-button" data-search-open aria-label="{{ 'general.accessibility.search' | t }}">
            <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7.5"/><path d="m16.5 16.5 4 4"/></svg>
          </button>
          <noscript>
            <a class="icon-button" href="{{ routes.search_url }}" aria-label="{{ 'general.accessibility.search' | t }}">
              <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7.5"/><path d="m16.5 16.5 4 4"/></svg>
            </a>
          </noscript>
        {%- else -%}
          <a class="icon-button" href="{{ routes.search_url }}" aria-label="{{ 'general.search.title' | t }}">
            <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7.5"/><path d="m16.5 16.5 4 4"/></svg>
          </a>
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
        <a class="icon-button account-button" href="{{ routes.account_url }}" aria-label="{{ 'sections.header.account' | t }}">
          <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M4.5 21a7.5 7.5 0 0 1 15 0"/></svg>
        </a>
      {%- endif -%}

      {%- if settings.cart_type == 'drawer' -%}
        <button type="button" class="icon-button" data-cart-open aria-label="{{ 'general.accessibility.cart' | t }}">
          <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 8h14l-1 13H6L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>
          <span class="cart-count" data-cart-count data-empty="{% if cart.item_count == 0 %}true{% else %}false{% endif %}">{{ cart.item_count }}</span>
        </button>
        <noscript>
          <a class="icon-button" href="{{ routes.cart_url }}" aria-label="{{ 'general.accessibility.cart' | t }}">
            <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 8h14l-1 13H6L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>
          </a>
        </noscript>
      {%- else -%}
        <a class="icon-button" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">
          <svg viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 8h14l-1 13H6L5 8Z"/><path d="M9 9V6a3 3 0 0 1 6 0v3"/></svg>
          <span class="cart-count" data-cart-count data-empty="{% if cart.item_count == 0 %}true{% else %}false{% endif %}">{{ cart.item_count }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>

  {% render 'mobile-menu', menu: primary_menu, menu_id: section.id %}
</header>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "header-section",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu" },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show customer account", "default": true },
    { "type": "header", "content": "Mega menu feature" },
    { "type": "collection", "id": "mega_feature_collection", "label": "Featured collection" },
    { "type": "product", "id": "mega_feature_product", "label": "Featured product" },
    { "type": "image_picker", "id": "mega_promo_image", "label": "Promotional image" },
    { "type": "text", "id": "mega_promo_heading", "label": "Promotional image heading" },
    { "type": "url", "id": "mega_promo_link", "label": "Promotional image link" }
  ]
}
{% endschema %}
