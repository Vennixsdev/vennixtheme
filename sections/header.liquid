<header
  class="site-header"
  data-header
  data-sticky-{{ settings.sticky_header | default: true }}
>
  <div class="container header-bar">
    <div class="header-logo">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} — Home">
        {%- if settings.logo != blank -%}
          <img src="{{ settings.logo | image_url: width: settings.logo_width | default: 120 }}" width="{{ settings.logo_width | default: 120 }}" alt="{{ shop.name | escape }}" loading="eager">
        {%- else -%}
          <span class="logo-mark" aria-hidden="true">{{ shop.name | slice: 0 }}</span>
          <strong>{{ shop.name }}</strong>
        {%- endif -%}
      </a>
    </div>

    <nav class="header-nav" aria-label="Primary">
      <ul class="header-nav-list">
        {%- for link in linklists[section.settings.menu].links -%}
          <li class="{% if link.links.size > 0 %}has-mega{% endif %}">
            <a href="{{ link.url }}" aria-current="{% if link.active %}page{% endif %}">
              {{ link.title }}
              {%- if link.links.size > 0 -%}
                <svg class="nav-caret" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
              {%- endif -%}
            </a>
            {%- if link.links.size > 0 -%}
              {% render 'mega-menu', links: link.links, parent_title: link.title %}
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>

    <div class="header-actions">
      <button type="button" class="icon-btn header-search-trigger" data-search-open aria-label="{{ 'general.accessibility.search' | t }}">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      </button>
      <a href="{{ routes.account_url }}" class="icon-btn" aria-label="{{ 'sections.header.account' | t | default: 'Account' }}">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </a>
      <button type="button" class="icon-btn" data-cart-open aria-label="{{ 'general.accessibility.cart' | t }}">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        <span class="icon-btn-badge" data-cart-count data-empty="{{ cart.item_count | default: 0 == 0 }}">{{ cart.item_count | default: 0 }}</span>
      </button>
      <button type="button" class="icon-btn menu-toggle" data-mobile-trigger aria-label="{{ 'general.accessibility.menu' | t }}">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
      </button>
    </div>
  </div>

  {% render 'mobile-menu' %}
</header>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Main menu", "default": "main-menu" },
    { "type": "checkbox", "id": "show_search", "label": "Show search button", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account link", "default": true }
  ]
}
{% endschema %}
