{%- if section.blocks.size > 0 -%}
  <section class="section-space">
    <div class="container">
      <div class="section-heading"><div><h2>{{ section.settings.title }}</h2></div></div>
      <div class="collection-list collection-list--{{ section.settings.columns }}">
        {%- for block in section.blocks -%}
          {%- assign collection_item = block.settings.collection -%}
          {%- if collection_item != blank -%}
            {%- assign collection_image = collection_item.image | default: collection_item.products.first.featured_image -%}
            <a class="collection-card collection-card--landscape" href="{{ collection_item.url }}" {{ block.shopify_attributes }}>
              <div class="collection-card-media">
                {%- if collection_image != blank -%}{{ collection_image | image_url: width: 1000 | image_tag: widths: '360, 540, 750, 1000', sizes: '(max-width: 749px) 82vw, 33vw', loading: 'lazy', alt: collection_item.title }}{%- else -%}<span class="media-placeholder" aria-hidden="true"></span>{%- endif -%}
              </div>
              <div class="collection-card-content"><h3>{{ block.settings.title | default: collection_item.title }}</h3><p>{{ collection_item.products_count }} {{ collection_item.products_count | pluralize: 'product', 'products' }}</p></div>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Collection list",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Collections" },
    { "type": "select", "id": "columns", "label": "Desktop columns", "default": "3", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }] }
  ],
  "blocks": [{ "type": "collection", "name": "Collection", "settings": [{ "type": "collection", "id": "collection", "label": "Collection" }, { "type": "text", "id": "title", "label": "Custom title" }] }],
  "max_blocks": 8,
  "presets": [{ "name": "Collection list" }]
}
{% endschema %}
