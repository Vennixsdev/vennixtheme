<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} — Home">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 360 | image_tag: widths: '160, 240, 360', sizes: '160px', loading: 'lazy', alt: shop.name, class: 'footer-logo' }}
        {%- else -%}
          <strong class="footer-wordmark">{{ shop.name }}</strong>
        {%- endif -%}
      </a>
      {%- if section.settings.brand_text != blank -%}<div class="footer-brand-text">{{ section.settings.brand_text }}</div>{%- endif -%}
      {%- if settings.support_email != blank -%}
        <a class="footer-support" href="mailto:{{ settings.support_email | escape }}">{{ settings.support_email }}</a>
      {%- endif -%}
      {%- if settings.store_phone != blank -%}<a class="footer-support" href="tel:{{ settings.store_phone | escape }}">{{ settings.store_phone }}</a>{%- endif -%}
      {%- if settings.support_hours != blank -%}<p class="footer-hours">{{ settings.support_hours }}</p>{%- endif -%}

      {%- if settings.social_instagram != blank or settings.social_tiktok != blank or settings.social_x != blank or settings.social_youtube != blank -%}
        <ul class="social-list" role="list" aria-label="Social links">
          {%- if settings.social_instagram != blank -%}<li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">Instagram</a></li>{%- endif -%}
          {%- if settings.social_tiktok != blank -%}<li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">TikTok</a></li>{%- endif -%}
          {%- if settings.social_x != blank -%}<li><a href="{{ settings.social_x }}" target="_blank" rel="noopener" aria-label="X">X</a></li>{%- endif -%}
          {%- if settings.social_youtube != blank -%}<li><a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">YouTube</a></li>{%- endif -%}
        </ul>
      {%- endif -%}
    </div>

    {%- for i in (1..3) -%}
      {%- liquid
        case i
          when 1
            assign footer_menu = section.settings.menu_shop
            assign footer_heading = section.settings.menu_shop_heading
          when 2
            assign footer_menu = section.settings.menu_care
            assign footer_heading = section.settings.menu_care_heading
          else
            assign footer_menu = section.settings.menu_about
            assign footer_heading = section.settings.menu_about_heading
        endcase
      -%}
      {%- if footer_menu != blank -%}
        <nav class="footer-column" aria-label="{{ footer_heading | escape }}">
          <h2>{{ footer_heading }}</h2>
          <ul role="list">
            {%- for link in footer_menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- endfor -%}

    <nav class="footer-column" aria-label="Account and policies">
      <h2>{{ section.settings.account_heading }}</h2>
      <ul role="list">
        {%- if shop.customer_accounts_enabled -%}<li><a href="{{ routes.account_url }}">Customer account</a></li>{%- endif -%}
        {%- if shop.refund_policy != blank -%}<li><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></li>{%- endif -%}
        {%- if shop.shipping_policy != blank -%}<li><a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a></li>{%- endif -%}
        {%- if shop.privacy_policy != blank -%}<li><a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a></li>{%- endif -%}
        {%- if shop.terms_of_service != blank -%}<li><a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a></li>{%- endif -%}
      </ul>
    </nav>

    {%- if section.settings.show_newsletter -%}
      <div class="footer-newsletter">
        <h2>{{ section.settings.newsletter_heading }}</h2>
        {%- if section.settings.newsletter_text != blank -%}<p>{{ section.settings.newsletter_text }}</p>{%- endif -%}
        {% form 'customer', id: 'FooterNewsletter', class: 'newsletter-form' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="FooterNewsletterEmail">Email address</label>
          <div class="newsletter-fields">
            <input id="FooterNewsletterEmail" class="input" type="email" name="contact[email]" value="{% if customer %}{{ customer.email }}{% endif %}" autocomplete="email" autocapitalize="off" placeholder="Email address" required>
            <button class="button button--primary" type="submit">Subscribe</button>
          </div>
          {%- if form.posted_successfully? -%}<p class="form-message" role="status">Thanks for subscribing.</p>{%- endif -%}
          {%- if form.errors -%}<div class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
        {% endform %}
      </div>
    {%- endif -%}
  </div>

  <div class="container footer-bottom">
    <small>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</small>
    {%- if settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <div class="payment-icons" aria-label="Enabled payment methods">
        {%- for type in shop.enabled_payment_types -%}{{ type | payment_type_svg_tag }}{%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "settings": [
    { "type": "richtext", "id": "brand_text", "label": "Brand text" },
    { "type": "text", "id": "menu_shop_heading", "label": "Shop menu heading", "default": "Shop" },
    { "type": "link_list", "id": "menu_shop", "label": "Shop menu" },
    { "type": "text", "id": "menu_care_heading", "label": "Customer care menu heading", "default": "Customer care" },
    { "type": "link_list", "id": "menu_care", "label": "Customer care menu" },
    { "type": "text", "id": "menu_about_heading", "label": "About menu heading", "default": "About" },
    { "type": "link_list", "id": "menu_about", "label": "About menu" },
    { "type": "text", "id": "account_heading", "label": "Account and policy heading", "default": "Account & policies" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show newsletter", "default": true },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Stay in the loop" },
    { "type": "textarea", "id": "newsletter_text", "label": "Newsletter text", "default": "Product news and store updates, sent to your inbox." }
  ]
}
{% endschema %}
