<footer class="site-footer" role="contentinfo">
  <div class="container stack">

    {%- if section.settings.show_trust_badges -%}
      <div class="trust-block">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust' -%}
            <div class="trust-item" {{ block.shopify_attributes }}>
              {%- if block.settings.icon != blank -%}{{ block.settings.icon }}{%- endif -%}
              <div>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="footer-grid">
      <div class="footer-brand">
        <a href="{{ routes.root_url }}" class="footer-brand-mark" aria-label="{{ shop.name | escape }}">
          {%- if settings.logo != blank -%}
            <img src="{{ settings.logo | image_url: width: 140 }}" alt="{{ shop.name | escape }}" loading="lazy" style="width:140px">
          {%- else -%}
            <strong style="font-size:1.4rem;">{{ shop.name }}</strong>
          {%- endif -%}
        </a>
        <p>{{ section.settings.brand_text | default: 'Bold products, crafted with intention. Designed for creators, builders, and style outlaws.' }}</p>

        {%- if settings.enable_predictive -%}
          <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
            <input type="search" name="q" placeholder="{{ 'general.search.placeholder' | t }}" autocomplete="off">
          </form>
        {%- endif -%}
      </div>

      <div class="footer-col">
        <h4>Shop</h4>
        <ul>
          {%- for link in linklists[section.settings.menu_shop].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- else -%}
            <li><a href="{{ collections.all.url }}">All products</a></li>
            <li><a href="{{ routes.collections_url }}">Collections</a></li>
            <li><a href="{{ routes.search_url }}">Search</a></li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Help</h4>
        <ul>
          <li><a href="mailto:{{ settings.support_email }}">Email support</a></li>
          <li><a href="{{ routes.account_url }}">My account</a></li>
          <li><a href="/pages/help">Help center</a></li>
          <li><a href="/pages/returns">Returns &amp; exchanges</a></li>
          <li><a href="/pages/shipping">Shipping</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Company</h4>
        <ul>
          {%- for link in linklists[section.settings.menu_company].links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- else -%}
            <li><a href="/pages/about">About</a></li>
            <li><a href="/pages/about">Sustainability</a></li>
            <li><a href="/pages/about">Press</a></li>
            <li><a href="/pages/contact">Contact</a></li>
          {%- endfor -%}
        </ul>
      </div>

      <div class="footer-col">
        <h4>Follow</h4>
        <ul class="footer-social">
          {%- if settings.social_instagram != blank -%}
            <li><a href="{{ settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
            </a></li>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <li><a href="{{ settings.social_tiktok }}" target="_blank" rel="noopener" aria-label="TikTok">
              <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64 2.93 2.93 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 5.8 20.1a6.34 6.34 0 0 0 10.86-4.43V8.55a8.16 8.16 0 0 0 4.77 1.52V6.69a4.85 4.85 0 0 1-1.84 0z"/></svg>
            </a></li>
          {%- endif -%}
          {%- if settings.social_x != blank -%}
            <li><a href="{{ settings.social_x }}" target="_blank" rel="noopener" aria-label="X">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a></li>
          {%- endif -%}
          {%- if settings.social_youtube != blank -%}
            <li><a href="{{ settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a></li>
          {%- endif -%}
        </ul>
        <div style="margin-top:1.1rem;">
          <h4>Support</h4>
          <ul>
            <li><a href="mailto:{{ settings.support_email }}" style="display:flex;gap:.4rem;align-items:center;">
              <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              {{ settings.support_email }}
            </a></li>
            {%- if settings.store_phone != blank -%}
              <li><a href="tel:{{ settings.store_phone }}">{{ settings.store_phone }}</a></li>
            {%- endif -%}
            {%- if settings.support_hours != blank -%}
              <li><small>{{ settings.support_hours }}</small></li>
            {%- endif -%}
          </ul>
        </div>
      </div>
    </div>

    <div class="footer-bot">
      <small>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</small>

      {%- if settings.show_payment_icons -%}
        <div class="footer-payment-icons" aria-label="Accepted payments">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "settings": [
    { "type": "textarea", "id": "brand_text", "label": "Brand description", "default": "Bold products, crafted with intention." },
    { "type": "link_list", "id": "menu_shop", "label": "Shop menu" },
    { "type": "link_list", "id": "menu_company", "label": "Company menu" },
    { "type": "checkbox", "id": "show_trust_badges", "label": "Show trust badges", "default": true },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust item",
      "settings": [
        { "type": "html", "id": "icon", "label": "SVG icon (24px)" },
        { "type": "text", "id": "title", "label": "Title", "default": "Free shipping" },
        { "type": "textarea", "id": "text", "label": "Description", "default": "On orders over $75" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "trust", "settings": { "title": "Free shipping", "text": "On orders over $75" } },
      { "type": "trust", "settings": { "title": "Easy returns", "text": "30-day change-of-mind" } },
      { "type": "trust", "settings": { "title": "Secure checkout", "text": "256-bit SSL • PCI compliant" } },
      { "type": "trust", "settings": { "title": "Real support", "text": "Reach a human — fast" } }
    ]
  }
}
{% endschema %}
