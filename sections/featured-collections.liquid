<section class="section-space">
  <div class="container">
    <div class="section-heading">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}<div class="section-heading-text rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      {%- if section.settings.view_all != blank and section.settings.view_all_label != blank -%}<a class="text-link" href="{{ section.settings.view_all }}">{{ section.settings.view_all_label }}</a>{%- endif -%}
    </div>

    <div class="collection-list collection-list--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- assign collection_item = block.settings.collection -%}
        {%- if collection_item != blank -%}
          {%- assign collection_image = collection_item.image | default: collection_item.products.first.featured_image -%}
          <a class="collection-card" href="{{ collection_item.url }}" {{ block.shopify_attributes }}>
            <div class="collection-card-media">
              {%- if collection_image != blank -%}
                {{ collection_image | image_url: width: 1200 | image_tag: widths: '320, 480, 640, 900, 1200', sizes: '(max-width: 749px) 82vw, 33vw', loading: 'lazy', alt: collection_item.title }}
              {%- else -%}
                <span class="media-placeholder" aria-hidden="true"></span>
              {%- endif -%}
            </div>
            <div class="collection-card-content">
              <h3>{{ block.settings.title | default: collection_item.title }}</h3>
              {%- if section.settings.show_count -%}<p>{{ collection_item.products_count }} {{ collection_item.products_count | pluralize: 'product', 'products' }}</p>{%- endif -%}
            </div>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by category",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop by category" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "columns", "label": "Desktop columns", "default": "3", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }] },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View-all label", "default": "View all" },
    { "type": "url", "id": "view_all", "label": "View-all link" }
  ],
  "blocks": [
    { "type": "collection", "name": "Collection", "settings": [{ "type": "collection", "id": "collection", "label": "Collection" }, { "type": "text", "id": "title", "label": "Custom title" }] }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Shop by category" }]
}
{% endschema %}
