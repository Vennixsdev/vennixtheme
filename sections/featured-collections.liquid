<section class="section-space">
  <div class="container">
    <div class="section-heading">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        <h2>{{ section.settings.title }}</h2>
        {%- if section.settings.text != blank -%}<div class="section-heading-text rte">{{ section.settings.text }}</div>{%- endif -%}
      </div>
      {%- if section.settings.view_all != blank and section.settings.view_all_label != blank -%}<a class="text-link" href="{{ section.settings.view_all }}">{{ section.settings.view_all_label }}</a>{%- endif -%}
    </div>

    <div class="collection-list collection-list--{{ section.settings.columns }}">
      {%- for block in section.blocks -%}
        {%- if block.settings.collection != blank -%}
          {% render 'collection-card',
            card_collection: block.settings.collection,
            card_title: block.settings.title,
            card_style: 'portrait',
            card_show_count: section.settings.show_count,
            card_heading_tag: 'h3',
            card_block: block
          %}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by category",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop by category" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "select", "id": "columns", "label": "Desktop columns", "default": "3", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }] },
    { "type": "checkbox", "id": "show_count", "label": "Show product count", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View-all label", "default": "View all" },
    { "type": "url", "id": "view_all", "label": "View-all link" }
  ],
  "blocks": [
    { "type": "collection", "name": "Collection", "settings": [{ "type": "collection", "id": "collection", "label": "Collection" }, { "type": "text", "id": "title", "label": "Custom title" }] }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Shop by category" }]
}
{% endschema %}
