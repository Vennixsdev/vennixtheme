<article class="container article section-space">
  {% render 'breadcrumbs' %}
  <header class="article-header">
    <p class="article-meta"><a href="{{ blog.url }}">{{ blog.title }}</a> · <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time></p>
    <h1>{{ article.title }}</h1>
  </header>
  {%- if article.image != blank -%}{{ article.image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1500, 1800', sizes: '(max-width: 900px) 100vw, 880px', class: 'article-image', loading: 'eager', fetchpriority: 'high', alt: article.title }}{%- endif -%}
  <div class="prose">{{ article.content }}</div>
</article>

{% schema %}
{ "name": "Article", "tag": "section" }
{% endschema %}
