{%- assign selected_variant = product.selected_or_first_available_variant -%}
{%- unless product.has_only_default_variant -%}
  <div class="variant-picker" data-variant-picker>
    {%- for option in product.options_with_values -%}
      <fieldset class="variant-fieldset" data-option-index="{{ forloop.index0 }}">
        <legend>{{ option.name }}: <strong data-selected-option>{{ option.selected_value }}</strong></legend>
        <div class="variant-values">
          {%- for value in option.values -%}
            {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: value | handle -%}
            <input
              class="visually-hidden variant-input"
              type="radio"
              id="{{ input_id }}"
              name="options[{{ option.name | escape }}]"
              value="{{ value | escape }}"
              data-option-input
              {% if option.selected_value == value %}checked{% endif %}
            >
            <label class="variant-label" for="{{ input_id }}">{{ value }}</label>
          {%- endfor -%}
        </div>
      </fieldset>
    {%- endfor -%}
  </div>

  {%- comment -%}
    Single name="id" control. JS keeps the radio UI and updates this select.
    No-JS users get the native select so Shopify receives the chosen variant ID.
  {%- endcomment -%}
  <div class="product-variant-id-wrap">
    <label class="product-variant-id-label no-js-only" for="VariantId-{{ section.id }}">{{ 'products.product.choose_options' | t }}</label>
    <select
      class="select product-variant-id"
      id="VariantId-{{ section.id }}"
      name="id"
      data-variant-id
    >
      {%- for variant in product.variants -%}
        <option value="{{ variant.id }}"{% if variant.id == selected_variant.id %} selected{% endif %}>
          {{ variant.title }}{% unless variant.available %} — {{ 'products.product.sold_out' | t }}{% endunless %}
        </option>
      {%- endfor -%}
    </select>
  </div>
{%- else -%}
  <input type="hidden" name="id" value="{{ selected_variant.id }}" data-variant-id>
{%- endunless -%}
