{%- liquid
  assign badge_product = product | default: card_product
  assign badge_best = false
  assign badge_new_arrival = false
  assign badge_new = false
  assign badge_limited = false

  for product_tag in badge_product.tags
    assign tag_handle = product_tag | handleize
    case tag_handle
      when 'best-seller', 'bestseller'
        assign badge_best = true
      when 'new-arrival', 'new-arrivals'
        assign badge_new_arrival = true
      when 'new'
        assign badge_new = true
      when 'limited-edition', 'limited'
        assign badge_limited = true
    endcase
  endfor
-%}
<div class="badge-list" aria-label="Product status">
  {%- if badge_product.available == false -%}
    <span class="badge badge--neutral">Sold out</span>
  {%- elsif badge_product.compare_at_price_max > badge_product.price_min -%}
    <span class="badge badge--sale">Sale</span>
  {%- endif -%}
  {%- if badge_best -%}<span class="badge">Best seller</span>{%- endif -%}
  {%- if badge_new_arrival -%}<span class="badge">New arrival</span>{%- elsif badge_new -%}<span class="badge">New</span>{%- endif -%}
  {%- if badge_limited -%}<span class="badge">Limited edition</span>{%- endif -%}
</div>
