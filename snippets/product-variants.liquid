<script id="VennixVariants" type="application/json">
[
  {%- for v in product.variants -%}
  {
    "id": {{ v.id }},
    "title": {{ v.title | json }},
    "options": [{%- for o in v.options -%}{{ o | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
    "available": {{ v.available }},
    "price": {{ v.price }},
    "compare_at_price": {{ v.compare_at_price | default: 0 }},
    "featured_media": {%- if v.featured_image -%}{"preview_image":"{{ v.featured_image | image_url: width: 1200 }}", "id":{{ v.featured_image.id }}}{%- else -%}null{%- endif -%}
  }{%- unless forloop.last -%},{%- endunless -%}
  {%- endfor -%}
]
</script>
{{ 'product.js' | asset_url | script_tag: defer: true }}
