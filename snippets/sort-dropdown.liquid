<label class="sort-control">
  <span>Sort by</span>
  <select class="select" name="sort_by" data-sort-select aria-label="Sort products">
    {%- assign selected_sort = collection.sort_by | default: collection.default_sort_by -%}
    {%- for option in collection.sort_options -%}
      <option value="{{ option.value | escape }}"{% if option.value == selected_sort %} selected{% endif %}>{{ option.name | escape }}</option>
    {%- endfor -%}
  </select>
</label>
