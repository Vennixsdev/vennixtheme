{%- liquid
  assign og_title = page_title
  assign og_description = page_description | default: shop.description | default: shop.name
  assign og_image = settings.logo
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="website">
<meta property="og:description" content="{{ og_description | escape }}">
{%- if og_image != blank -%}
<meta property="og:image" content="{{ og_image | image_url: width: 1200 }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if og_image != blank -%}
<meta name="twitter:image" content="{{ og_image | image_url: width: 800 }}">
{%- endif -%}
{%- if template.name == 'product' -%}
<meta property="og:type" content="product">
<meta property="product:price:amount" content="{{ product.price | money_without_currency | strip_html | escape }}">
<meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{%- endif -%}
