{%- liquid
  assign price_product = product | default: card_product
  assign target = price_product
  if use_variant
    assign target = price_product.selected_or_first_available_variant
  endif

  assign current_price = target.price
  assign compare_price = target.compare_at_price
  assign varies = price_product.price_varies
  assign on_sale = false
  if compare_price != blank and compare_price > current_price
    assign on_sale = true
  endif
-%}
<div class="price{% if compact %} price--compact{% endif %}" data-price>
  <div class="price-main">
    {%- if varies and use_variant != true -%}<span class="price-prefix">From</span>{%- endif -%}
    <span class="price-current{% if on_sale %} price-current--sale{% endif %}">{{ current_price | money }}</span>
    {%- if on_sale -%}<s class="price-compare">{{ compare_price | money }}</s>{%- endif -%}
  </div>
  {%- if target.unit_price_measurement -%}
    <small class="unit-price">
      {{ target.unit_price | money }} /
      {%- if target.unit_price_measurement.reference_value != 1 -%}{{ target.unit_price_measurement.reference_value }}{%- endif -%}
      {{ target.unit_price_measurement.reference_unit }}
    </small>
  {%- endif -%}
</div>
