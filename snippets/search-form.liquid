<form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
  <input type="search" name="q" placeholder="{{ 'general.search.placeholder' | t }}" value="{{ search.terms | escape }}" autocomplete="off">
  {%- if search.types -%}
    <input type="hidden" name="type" value="{{ search.types | join: ',' }}">
  {%- endif -%}
  <button type="submit" class="btn btn--primary" aria-label="{{ 'general.search.submit' | t }}">Search</button>
</form>
