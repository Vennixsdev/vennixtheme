<div class="predictive-search-dialog" data-predictive-dialog role="dialog" aria-modal="true" aria-labelledby="PredictiveSearchTitle" tabindex="-1">
  <h2 class="visually-hidden" id="PredictiveSearchTitle">{{ 'general.search.title' | t }}</h2>
  <form class="predictive-search-form" action="{{ routes.search_url }}" method="get" role="search">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="7.5"/><path d="m16.5 16.5 4 4"/></svg>
    <label class="visually-hidden" for="PredictiveSearchInput">{{ 'general.search.title' | t }}</label>
    <input id="PredictiveSearchInput" type="search" name="q" placeholder="{{ 'general.search.placeholder' | t }}" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="PredictiveSearchResults" data-predictive-input>
    <input type="hidden" name="options[prefix]" value="last">
    <button type="submit" class="visually-hidden">{{ 'general.search.submit' | t }}</button>
    <button type="button" class="icon-button" data-search-close aria-label="{{ 'general.accessibility.close' | t }}">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19"/></svg>
    </button>
  </form>

  <div class="predictive-search-results" id="PredictiveSearchResults" data-predictive-body role="listbox" aria-live="polite">
    {%- assign suggestion_menu = settings.search_suggestions_menu -%}
    {%- if suggestion_menu != blank -%}
      <div class="predictive-group predictive-browse">
        <h3>{{ 'general.search.browse' | t }}</h3>
        <ul role="list">
          {%- for link in suggestion_menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}
        </ul>
      </div>
    {%- else -%}
      <p class="predictive-hint">Start typing to search the store.</p>
    {%- endif -%}
  </div>

  <div class="predictive-search-footer">
    <span>Use ↑ and ↓ to navigate. Press Escape to close.</span>
    <a href="{{ routes.search_url }}" data-search-view-all hidden>{{ 'general.search.view_all' | t }}</a>
  </div>
</div>
