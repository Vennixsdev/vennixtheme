<form class="filter-form" data-filter-form action="{{ collection.url }}" method="get">
  {%- if collection.sort_by != blank -%}<input type="hidden" name="sort_by" value="{{ collection.sort_by }}">{%- endif -%}

  <div class="filter-drawer-head">
    <div><h2 id="FilterHeading-{{ section.id }}">Filters</h2>{%- if active_filter_count > 0 -%}<span>{{ active_filter_count }} active</span>{%- endif -%}</div>
    <button type="button" class="icon-button filter-close" data-filter-close aria-label="{{ 'general.accessibility.close' | t }}">
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m5 5 14 14M19 5 5 19"/></svg>
    </button>
  </div>

  <div class="filter-form-body">
    {%- for filter in collection.filters -%}
      <details class="filter-group" open>
        <summary>
          <span>{{ filter.label }}{% if filter.active_values.size > 0 %} <small>({{ filter.active_values.size }})</small>{% endif %}</span>
          <svg viewBox="0 0 12 8" width="12" height="8" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m1 1 5 5 5-5"/></svg>
        </summary>

        <div class="filter-group-content">
          {%- case filter.type -%}
            {%- when 'boolean', 'list' -%}
              <ul class="filter-values" role="list">
                {%- for value in filter.values -%}
                  {%- if value.count > 0 or value.active -%}
                    <li>
                      <label class="filter-value{% if value.active %} is-active{% endif %}" for="Filter-{{ section.id }}-{{ filter.param_name | handle }}-{{ forloop.index }}">
                        <input
                          id="Filter-{{ section.id }}-{{ filter.param_name | handle }}-{{ forloop.index }}"
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}checked{% endif %}
                        >
                        <span class="filter-check" aria-hidden="true"></span>
                        <span class="filter-value-label">{{ value.label }}</span>
                        <span class="filter-count">{{ value.count }}</span>
                      </label>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- when 'price_range' -%}
              {%- liquid
                assign range_max = filter.range_max | money_without_currency | replace: ',', ''
                assign min_value = filter.min_value.value | money_without_currency | replace: ',', ''
                assign max_value = filter.max_value.value | money_without_currency | replace: ',', ''
              -%}
              <div class="price-filter">
                <label>
                  <span>Minimum</span>
                  <span class="price-input"><span>{{ cart.currency.iso_code }}</span><input type="number" name="{{ filter.min_value.param_name }}" min="0" max="{{ range_max }}" value="{{ min_value }}" placeholder="0"></span>
                </label>
                <label>
                  <span>Maximum</span>
                  <span class="price-input"><span>{{ cart.currency.iso_code }}</span><input type="number" name="{{ filter.max_value.param_name }}" min="0" max="{{ range_max }}" value="{{ max_value }}" placeholder="{{ range_max }}"></span>
                </label>
              </div>
          {%- endcase -%}
        </div>
      </details>
    {%- endfor -%}
  </div>

  <div class="filter-actions">
    {%- if active_filter_count > 0 -%}<a class="button button--secondary" href="{{ collection.url }}{% if collection.sort_by != blank %}?sort_by={{ collection.sort_by | url_encode }}{% endif %}">Clear all</a>{%- endif -%}
    <button class="button button--primary" type="submit">Apply filters</button>
  </div>
</form>
