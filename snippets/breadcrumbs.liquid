{%- if settings.show_breadcrumbs and request.page_type != 'index' -%}
  <nav class="crumbs" aria-label="Breadcrumb">
    <ol role="list">
      <li><a href="{{ routes.root_url }}">Home</a></li>
      {%- case request.page_type -%}
        {%- when 'product' -%}
          {%- if collection != blank -%}<li><a href="{{ collection.url }}">{{ collection.title }}</a></li>{%- endif -%}
          <li><span aria-current="page">{{ product.title }}</span></li>
        {%- when 'collection' -%}<li><span aria-current="page">{{ collection.title }}</span></li>
        {%- when 'cart' -%}<li><span aria-current="page">Cart</span></li>
        {%- when 'search' -%}<li><span aria-current="page">Search</span></li>
        {%- when 'page' -%}<li><span aria-current="page">{{ page.title }}</span></li>
        {%- when 'blog' -%}<li><span aria-current="page">{{ blog.title }}</span></li>
        {%- when 'article' -%}<li><a href="{{ blog.url }}">{{ blog.title }}</a></li><li><span aria-current="page">{{ article.title }}</span></li>
      {%- endcase -%}
    </ol>
  </nav>
{%- endif -%}
