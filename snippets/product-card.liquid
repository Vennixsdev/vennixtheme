{%- liquid
  assign p = product | default: card_product
  assign featured_alt = p.featured_image
  assign hover_alt = null
  assign imgs = p.images | default: empty
  if imgs.size > 1
    assign hover_alt = imgs[1]
  endif
  assign is_unavailable = false
  if p.available == false
    assign is_unavailable = true
  endif
-%}
<article class="product-card reveal" data-product-card data-product-id="{{ p.id }}">
  <a class="product-card-media" href="{{ p.url }}" aria-label="{{ p.title | escape }}">
    <span class="product-card-badge-stack">
      {% render 'badge', product: p %}
    </span>
    <button type="button" class="product-card-wishlist" aria-label="Save for later" aria-pressed="false">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    </button>
    {%- if featured_alt -%}
      <img class="primary" src="{{ featured_alt | image_url: width: 600 }}" alt="{{ p.title | escape }}" loading="lazy" width="600" height="600">
    {%- else -%}
      <div class="primary" style="display:grid;place-items:center;width:100%;height:100%;background:color-mix(in oklab,var(--color-surface-2) 80%,transparent);color:var(--color-muted);font-size:.85rem;">{{ p.title }}</div>
    {%- endif -%}
    {%- if hover_alt -%}
      <img class="alt" src="{{ hover_alt | image_url: width: 600 }}" alt="" loading="lazy" width="600" height="600" aria-hidden="true">
    {%- endif -%}
    {%- if settings.show_quick_add and p.has_only_default_variant == false or settings.show_quick_add and p.available -%}
      <div class="product-card-quick">
        {%- if is_unavailable -%}
          <a href="{{ p.url }}" class="btn btn--ghost btn--block">View</a>
        {%- elsif p.has_only_default_variant -%}
          <form method="post" action="{{ routes.cart_add_url }}" class="quick-add-form">
            <input type="hidden" name="id" value="{{ p.variants.first.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="btn btn--primary btn--block" data-quick-add>{{ 'products.product.quick_add' | t }}</button>
          </form>
        {%- else -%}
          <a href="{{ p.url }}" class="btn btn--primary btn--block">{{ 'products.product.quick_add' | t }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </a>
  <div class="product-card-body">
    {%- if p.vendor != blank -%}
      <small class="product-card-vendor">{{ p.vendor }}</small>
    {%- endif -%}
    <h3 class="product-card-title"><a href="{{ p.url }}">{{ p.title }}</a></h3>
    <div class="product-card-foot">
      {% render 'price', product: p %}
      {%- if p.metafields.reviews.rating != blank -%}
        <span class="product-card-rating" aria-label="{{ p.metafields.reviews.rating }} out of 5">
          ★ {{ p.metafields.reviews.rating }} ({{ p.metafields.reviews.rating_count | default: 0 }})
        </span>
      {%- endif -%}
    </div>
  </div>
</article>
