{%- assign support_address = settings.support_email | default: 'support@vennixstore.com' -%}
<div class="support-widget" data-support-pop data-open="false">
  <button type="button" class="support-toggle" data-support-toggle aria-expanded="false" aria-controls="SupportPanel" aria-label="Open customer support">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 4h16v13H8l-4 4V4Z"/><path d="M8 9h8M8 13h5"/></svg>
    <span>Support</span>
  </button>
  <div class="support-panel" id="SupportPanel" data-support-card tabindex="-1">
    <div><strong>Customer support</strong><button type="button" data-support-close aria-label="{{ 'general.accessibility.close' | t }}">×</button></div>
    <a href="mailto:{{ support_address | escape }}">{{ support_address }}</a>
    {%- if settings.support_hours != blank -%}<p>{{ settings.support_hours }}</p>{%- endif -%}
  </div>
</div>
