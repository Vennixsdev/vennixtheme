{%- liquid
  assign email_addr = settings.support_email | default: 'support@vennixstore.com'
-%}
<div class="vsupport-pop" data-support-pop hidden role="region" aria-label="Need help?">
  <button type="button" class="vsupport-trigger" data-support-toggle aria-expanded="false" aria-label="Toggle support widget">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
    <span class="vsupport-trigger-label">Need help?</span>
  </button>
  <div class="vsupport-card" data-support-card role="dialog" aria-labelledby="vsupport-title">
    <div class="vsupport-head">
      <strong id="vsupport-title">We're here for you</strong>
      <button type="button" class="vsupport-close" data-support-close aria-label="Close support panel">×</button>
    </div>
    <p class="vsupport-msg">Any questions about your order or our products? Reach our team directly.</p>
    <a class="vsupport-email" href="mailto:{{ email_addr | escape }}?subject=Help%20-%20{{ shop.name | escape }}">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
      {{ email_addr }}
    </a>
    {%- if settings.support_hours != blank -%}
      <p class="vsupport-hours">Hours: {{ settings.support_hours }}</p>
    {%- endif -%}
  </div>
</div>
