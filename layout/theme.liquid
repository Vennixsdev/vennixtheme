<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0,minimum-scale=1.0">
    <meta name="theme-color" content="{{ settings.color_background | default: '#0b0b0f' }}">
    <meta name="description" content="{{ page_description | escape }}">
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>
      {{ page_title -}}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- liquid
      render 'seo-meta'
    -%}

    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {{ content_for_header }}

    {{ 'styles.css' | asset_url | stylesheet_tag }}
    {{ 'theme.js' | asset_url | script_tag: defer: true }}
    {{ 'cart.js' | asset_url | script_tag: defer: true }}
    {{ 'search.js' | asset_url | script_tag: defer: true }}
    {{ 'wishlist.js' | asset_url | script_tag: defer: true }}

    {%- style -%}
      :root {
        --color-bg: {{ settings.color_background | default: '#0b0b0f' }};
        --color-fg: {{ settings.color_text | default: '#f5f5f7' }};
        --color-accent: {{ settings.color_accent | default: '#7c5cff' }};
        --color-accent-2: {{ settings.color_accent_2 | default: '#ff5c97' }};
        --color-muted: {{ settings.color_muted | default: '#8a8a93' }};
        --color-border: {{ settings.color_border | default: 'rgba(255,255,255,0.08)' }};
        --color-surface: {{ settings.color_surface | default: '#14141a' }};
        --color-surface-2: {{ settings.color_surface_2 | default: '#1c1c24' }};
        --color-success: {{ settings.color_success | default: '#22c55e' }};
        --color-danger: {{ settings.color_danger | default: '#ef4444' }};
        --radius-sm: 6px;
        --radius-md: 12px;
        --radius-lg: 20px;
        --shadow-sm: 0 2px 8px rgba(0,0,0,0.25);
        --shadow-md: 0 8px 30px rgba(0,0,0,0.35);
        --shadow-lg: 0 25px 60px rgba(0,0,0,0.45);
        --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
        --header-h: 72px;
      }
    {%- endstyle -%}
  </head>

  <body class="template-{{ template | replace: '.', '-' | handleize }}{% if cart.item_count > 0 %} has-cart-items{% endif %}">
    <a class="skip-link" href="#MainContent">Skip to content</a>

    {% sections 'header-group' %}

    <main id="MainContent" class="main-content" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <div id="CartDrawerMount" class="cart-drawer-mount" aria-hidden="true">
      {%- if settings.cart_type == 'drawer' -%}
        {%- section 'cart-drawer' -%}
      {%- endif -%}
    </div>
    <div id="PredictiveSearchMount" class="predictive-search-mount" aria-hidden="true">
      {% render 'predictive-search' %}
    </div>

    {%- render 'support-email' -%}

    <script type="application/json" id="ShopifyAppContext">
      {
        "shop": {
          "name": {{ shop.name | json }},
          "domain": {{ shop.domain | json }},
          "currency": {{ shop.currency | json }},
          "moneyFormat": {{ shop.money_format | json }}
        },
        "routes": {
          "root": {{ routes.root_url | json }},
          "cart": {{ routes.cart_url | json }},
          "cartAdd": {{ routes.cart_add_url | json }},
          "cartChange": {{ routes.cart_change_url | json }},
          "search": {{ routes.search_url | json }},
          "collections": {{ routes.collections_url | json }}
        },
        "cart": {
          "itemCount": {{ cart.item_count | json }},
          "totalPrice": {{ cart.total_price | json }}
        },
        "settings": {
          "moneyFormat": {{ shop.money_format | json }},
          "currency": {{ cart.currency.iso_code | default: shop.currency | json }},
          "locale": {{ request.locale.iso_code | json }},
          "cart_type": {{ settings.cart_type | json }},
          "freeShippingBar": {{ settings.free_shipping_bar | json }},
          "freeShippingThreshold": {{ settings.free_shipping_threshold | default: 0 | times: 1 | json }},
          "ajaxEnabled": true
        },
        "strings": {
          "addToCart": {{ 'products.product.add_to_cart' | t | json }},
          "soldOut": {{ 'products.product.sold_out' | t | json }},
          "added": {{ 'cart.general.added' | t | json }},
          "cartEmpty": {{ 'cart.general.empty' | t | json }},
          "continueShopping": {{ 'cart.general.continue_shopping' | t | json }},
          "freeShippingDone": {{ 'cart.free_shipping.progress_done' | t | json }},
          "freeShippingProgress": {{ 'cart.free_shipping.progress_made' | t: remaining: '__AMOUNT__' | json }},
          "searchUnavailable": {{ 'general.search.unavailable' | t | json }},
          "noResults": {{ 'general.search.no_results' | t: terms: '__TERMS__' | json }},
          "viewAll": {{ 'general.search.view_all' | t | json }}
        }
      }
    </script>
  </body>
</html>
