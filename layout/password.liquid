<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0,height=device-height,minimum-scale=1.0">
    <title>{{ shop.name }} — Coming Soon</title>
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {{ content_for_header }}

    {{ 'styles.css' | asset_url | stylesheet_tag }}
    {{ 'theme.js' | asset_url | script_tag: defer: true }}

    {%- style -%}
      :root {
        --color-bg: #0b0b0f;
        --color-fg: #f5f5f7;
        --color-accent: #7c5cff;
        --color-accent-2: #ff5c97;
        --color-muted: #8a8a93;
        --color-border: rgba(255,255,255,0.08);
        --color-surface: #14141a;
      }
    {%- endstyle -%}
  </head>
  <body class="template-password">
    <main class="container section" style="display:grid;place-items:center;min-height:100vh;text-align:center;">
      <div class="reveal" style="max-width:520px;">
        <small class="eyebrow">Coming soon</small>
        <h1 style="margin-block:0.7rem;">{{ shop.name }}</h1>
        <p style="color:var(--color-muted);margin-bottom:1.4rem;">{{ shop.description | default: 'Our new storefront is launching soon. Drop your email to get notified and unlock 10% off.' }}</p>
        <form method="post" action="/password" class="input-group" style="margin-block:auto;">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input class="input" type="email" name="contact[email]" placeholder="you@email.com" required>
          <button class="btn btn--primary" type="submit">Notify me</button>
        </form>
      </div>
    </main>
    {{ content_for_layout }}
  </body>
</html>
