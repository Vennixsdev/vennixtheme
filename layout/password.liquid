<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }} &ndash; Opening soon</title>
    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}
    {{ content_for_header }}
    <style>
      *{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:24px;background:#f7f7f5;color:#171715;font-family:system-ui,sans-serif}.password-card{width:min(100%,520px);text-align:center}.password-logo{max-width:160px;height:auto;margin:0 auto 32px}h1{font-size:clamp(2rem,8vw,4rem);line-height:1.05;margin:0 0 16px}p{color:#696963;line-height:1.6}.password-form{display:flex;gap:8px;margin-top:28px}.password-form input{min-width:0;flex:1;padding:14px 16px;border:1px solid #deded8;border-radius:8px;background:#fff;font:inherit}.password-form button{padding:14px 20px;border:0;border-radius:8px;background:#171715;color:#fff;font:inherit;font-weight:650;cursor:pointer}@media(max-width:420px){.password-form{flex-direction:column}}
    </style>
  </head>
  <body>
    <main class="password-card">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 320 | image_tag: class: 'password-logo', alt: shop.name, loading: 'eager' }}
      {%- endif -%}
      <h1>{{ shop.name }}</h1>
      {%- if shop.description != blank -%}<p>{{ shop.description }}</p>{%- endif -%}
      {% form 'storefront_password', class: 'password-form' %}
        <label class="visually-hidden" for="Password">Store password</label>
        <input id="Password" type="password" name="password" autocomplete="current-password" placeholder="Store password" required>
        <button type="submit">Enter store</button>
        {{ form.errors | default_errors }}
      {% endform %}
    </main>
  </body>
</html>
